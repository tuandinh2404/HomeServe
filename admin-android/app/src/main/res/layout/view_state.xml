<?xml version="1.0" encoding="utf-8"?>
<!-- Lớp phủ của StateView: vòng xoay khi đang tải, câu thông báo, nút Thử lại.
     clickable + focusable: chặn bấm xuyên xuống danh sách phía dưới khi lớp phủ đang hiện. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ProgressBar
        android:id="@+id/pb_dang_tai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/tv_thong_bao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btn_thu_lai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/thu_lai" />

</LinearLayout>
